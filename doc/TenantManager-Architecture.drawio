        <mxCell id="n-title" value="TenantManager — Navigation and Feature Map" style="text;html=1;fontSize=24;fontStyle=1;align=left;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="40" as="geometry" /></mxCell>
        <mxCell id="n-launch" value="&lt;b&gt;App launch&lt;/b&gt;&lt;br&gt;BootSplash → getSession() → init user cache → Remote Config update check" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;spacing=10;" vertex="1" parent="1"><mxGeometry x="60" y="100" width="300" height="100" as="geometry" /></mxCell>
        <mxCell id="n-gate" value="&lt;b&gt;Root auth gate&lt;/b&gt;&lt;br&gt;Supabase session present?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#4F46E5;spacing=8;" vertex="1" parent="1"><mxGeometry x="430" y="100" width="180" height="110" as="geometry" /></mxCell>
        <mxCell id="n-authstack" value="AUTH STACK" style="swimlane;html=1;startSize=30;rounded=1;fillColor=#FDF2F8;strokeColor=#DB2777;fontStyle=1;fontColor=#831843;" vertex="1" parent="1"><mxGeometry x="700" y="70" width="460" height="360" as="geometry" /></mxCell>
        <mxCell id="n-authscreen" value="AuthScreen&lt;br&gt;&lt;i&gt;entry + Google sign-in&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE7F3;strokeColor=#EC4899;" vertex="1" parent="1"><mxGeometry x="735" y="125" width="180" height="70" as="geometry" /></mxCell>
        <mxCell id="n-login" value="LoginScreen&lt;br&gt;&lt;i&gt;email/password&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE7F3;strokeColor=#EC4899;" vertex="1" parent="1"><mxGeometry x="945" y="125" width="180" height="70" as="geometry" /></mxCell>
        <mxCell id="n-register" value="RegisterScreen&lt;br&gt;&lt;i&gt;Edge Function registration&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE7F3;strokeColor=#EC4899;" vertex="1" parent="1"><mxGeometry x="735" y="225" width="180" height="70" as="geometry" /></mxCell>
        <mxCell id="n-forgot" value="ForgotPasswordScreen&lt;br&gt;&lt;i&gt;send reset email&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE7F3;strokeColor=#EC4899;" vertex="1" parent="1"><mxGeometry x="945" y="225" width="180" height="70" as="geometry" /></mxCell>
        <mxCell id="n-reset" value="SetNewPasswordScreen&lt;br&gt;&lt;i&gt;tenantmanager:// deep link&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBCFE8;strokeColor=#DB2777;" vertex="1" parent="1"><mxGeometry x="840" y="325" width="190" height="70" as="geometry" /></mxCell>

        <mxCell id="n-main" value="MAIN TABS (authenticated)" style="swimlane;html=1;startSize=32;rounded=1;fillColor=#F0FDF4;strokeColor=#16A34A;fontStyle=1;fontColor=#14532D;" vertex="1" parent="1"><mxGeometry x="60" y="500" width="1210" height="650" as="geometry" /></mxCell>
        <mxCell id="n-dash" value="&lt;b&gt;Home&lt;/b&gt;&lt;br&gt;DashboardScreen&lt;br&gt;room/tenant/bill summary&lt;br&gt;direct mapping query" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#22C55E;spacing=8;" vertex="1" parent="1"><mxGeometry x="90" y="565" width="200" height="125" as="geometry" /></mxCell>
        <mxCell id="n-tenant" value="&lt;b&gt;Tenants&lt;/b&gt;&lt;br&gt;TenantList → Form / View&lt;br&gt;View → Document viewer&lt;br&gt;assignments + file media" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#22C55E;spacing=8;" vertex="1" parent="1"><mxGeometry x="320" y="565" width="210" height="125" as="geometry" /></mxCell>
        <mxCell id="n-room" value="&lt;b&gt;Rooms&lt;/b&gt;&lt;br&gt;RoomList → Form / View&lt;br&gt;tenant move-in/vacate&lt;br&gt;meter reading history" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#22C55E;spacing=8;" vertex="1" parent="1"><mxGeometry x="560" y="565" width="210" height="125" as="geometry" /></mxCell>
        <mxCell id="n-payment" value="&lt;b&gt;Payments&lt;/b&gt;&lt;br&gt;PaymentList → Form / View&lt;br&gt;bill + meter calculations&lt;br&gt;receipt PDF/share" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;spacing=8;" vertex="1" parent="1"><mxGeometry x="800" y="565" width="210" height="125" as="geometry" /></mxCell>
        <mxCell id="n-setting" value="&lt;b&gt;Settings&lt;/b&gt;&lt;br&gt;SettingScreen&lt;br&gt;property profile&lt;br&gt;water/electricity/rent dates" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;spacing=8;" vertex="1" parent="1"><mxGeometry x="1040" y="565" width="200" height="125" as="geometry" /></mxCell>
        <mxCell id="n-cross" value="&lt;b&gt;Cross-feature navigation&lt;/b&gt;&lt;br&gt;Dashboard opens core records • room/tenant selection sheets connect assignments • payment forms combine tenant, room, settings, bills and meter data" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;spacing=10;" vertex="1" parent="1"><mxGeometry x="260" y="755" width="790" height="90" as="geometry" /></mxCell>
        <mxCell id="n-header" value="&lt;b&gt;Header / menu access&lt;/b&gt;&lt;br&gt;TopMenuButton opens context-driven TopMenuDrawer&lt;br&gt;TopBackButton is reused by nested stacks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;spacing=10;" vertex="1" parent="1"><mxGeometry x="425" y="920" width="460" height="95" as="geometry" /></mxCell>
        <mxCell id="n-track" value="Navigation focus/state changes&lt;br&gt;→ Firebase screen analytics&lt;br&gt;→ screen_*_load performance traces" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;spacing=8;" vertex="1" parent="1"><mxGeometry x="425" y="1040" width="460" height="70" as="geometry" /></mxCell>

        <mxCell id="n-menu" value="MENU TABS (authenticated)" style="swimlane;html=1;startSize=32;rounded=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;fontStyle=1;fontColor=#4C1D95;" vertex="1" parent="1"><mxGeometry x="1330" y="500" width="600" height="650" as="geometry" /></mxCell>
        <mxCell id="n-menuhome" value="MenuHome&lt;br&gt;&lt;i&gt;returns to MainTabs&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;" vertex="1" parent="1"><mxGeometry x="1370" y="565" width="220" height="70" as="geometry" /></mxCell>
        <mxCell id="n-profile" value="Profile stack&lt;br&gt;ProfileScreen → ProfileForm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;" vertex="1" parent="1"><mxGeometry x="1640" y="565" width="230" height="70" as="geometry" /></mxCell>
        <mxCell id="n-password" value="Change password stack&lt;br&gt;update password + sign out" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;" vertex="1" parent="1"><mxGeometry x="1370" y="675" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="n-support" value="Support stack&lt;br&gt;Ticket list → New Ticket&lt;br&gt;Ticket Chat → Document" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#F97316;" vertex="1" parent="1"><mxGeometry x="1640" y="675" width="230" height="95" as="geometry" /></mxCell>
        <mxCell id="n-about" value="About stack&lt;br&gt;AboutUsScreen" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;" vertex="1" parent="1"><mxGeometry x="1500" y="820" width="230" height="70" as="geometry" /></mxCell>
        <mxCell id="n-update" value="&lt;b&gt;Global overlay&lt;/b&gt;&lt;br&gt;HardUpdateModal appears above navigation&lt;br&gt;force update blocks dismissal; optional update may close" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;spacing=10;" vertex="1" parent="1"><mxGeometry x="1425" y="955" width="355" height="105" as="geometry" /></mxCell>

        <mxCell id="ne1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#2563EB;" edge="1" parent="1" source="n-launch" target="n-gate"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ne2" value="No" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#DB2777;" edge="1" parent="1" source="n-gate" target="n-authstack"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ne3" value="Yes" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#16A34A;" edge="1" parent="1" source="n-gate" target="n-main"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ne4" value="menu" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#8B5CF6;" edge="1" parent="1" source="n-main" target="n-menu"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ne5" value="home" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#8B5CF6;dashed=1;" edge="1" parent="1" source="n-menuhome" target="n-main"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ne6" value="reset link" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#DB2777;dashed=1;" edge="1" parent="1" source="n-launch" target="n-reset"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="data-model" name="3 - Data Model &amp; Flows">
    <mxGraphModel dx="2100" dy="1350" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2100" pageHeight="1350" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="d-title" value="TenantManager — Supabase Data Model and Key Flows" style="text;html=1;fontSize=24;fontStyle=1;align=left;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="40" as="geometry" /></mxCell>
        <mxCell id="d-note" value="Relationships are inferred from service queries/types; database/schema.txt currently documents only the User table." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;spacing=8;" vertex="1" parent="1"><mxGeometry x="1330" y="20" width="690" height="55" as="geometry" /></mxCell>

        <mxCell id="d-auth" value="&lt;b&gt;auth.users&lt;/b&gt;&lt;br&gt;id: uuid&lt;br&gt;email / providers&lt;br&gt;Supabase-managed credentials" style="shape=table;childLayout=tableLayout;rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;spacing=8;" vertex="1" parent="1"><mxGeometry x="70" y="130" width="230" height="115" as="geometry" /></mxCell>
        <mxCell id="d-user" value="&lt;b&gt;User&lt;/b&gt;&lt;br&gt;id: bigint PK&lt;br&gt;user_id: uuid (auth identity)&lt;br&gt;first_name, last_name, mobile&lt;br&gt;email, address" style="shape=table;childLayout=tableLayout;rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;spacing=8;" vertex="1" parent="1"><mxGeometry x="390" y="115" width="260" height="145" as="geometry" /></mxCell>
        <mxCell id="d-setting" value="&lt;b&gt;setting&lt;/b&gt;&lt;br&gt;id, user_id&lt;br&gt;property_name/address&lt;br&gt;water, electricity_unit&lt;br&gt;rent_date, rent_due_date" style="shape=table;childLayout=tableLayout;rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;spacing=8;" vertex="1" parent="1"><mxGeometry x="750" y="115" width="250" height="145" as="geometry" /></mxCell>

        <mxCell id="d-tenant" value="&lt;b&gt;tenant&lt;/b&gt;&lt;br&gt;id: number PK • user_id&lt;br&gt;name + contact/address/company&lt;br&gt;family members&lt;br&gt;profile/Aadhaar/PAN/agreement URLs" style="shape=table;childLayout=tableLayout;rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;spacing=8;" vertex="1" parent="1"><mxGeometry x="100" y="380" width="285" height="155" as="geometry" /></mxCell>
        <mxCell id="d-map" value="&lt;b&gt;tenant_room_mapping&lt;/b&gt;&lt;br&gt;id • user_id&lt;br&gt;tenant_id FK • room_id FK&lt;br&gt;joining_date&lt;br&gt;leaving_date NULL = active" style="shape=table;childLayout=tableLayout;rounded=1;whiteSpace=wrap;html=1;fillColor=#CCFBF1;strokeColor=#0D9488;spacing=8;" vertex="1" parent="1"><mxGeometry x="500" y="380" width="275" height="155" as="geometry" /></mxCell>
        <mxCell id="d-room" value="&lt;b&gt;room&lt;/b&gt;&lt;br&gt;id: number PK • user_id&lt;br&gt;name, type, area&lt;br&gt;rent, deposit, comment&lt;br&gt;created_at, modified_at" style="shape=table;childLayout=tableLayout;rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;spacing=8;" vertex="1" parent="1"><mxGeometry x="890" y="380" width="260" height="155" as="geometry" /></mxCell>

        <mxCell id="d-bill" value="&lt;b&gt;bill&lt;/b&gt;&lt;br&gt;id • user_id • billing_month&lt;br&gt;tenant_id • room_id&lt;br&gt;rent, water, meter readings, electricity&lt;br&gt;ad hoc + total + paid amount + status" style="shape=table;childLayout=tableLayout;rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;spacing=8;" vertex="1" parent="1"><mxGeometry x="260" y="690" width="330" height="175" as="geometry" /></mxCell>
        <mxCell id="d-meter" value="&lt;b&gt;meter_reading&lt;/b&gt;&lt;br&gt;id • user_id (schema may vary)&lt;br&gt;tenant_id • room_id&lt;br&gt;unit • created_at&lt;br&gt;latest reading queried by room/tenant" style="shape=table;childLayout=tableLayout;rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#F97316;spacing=8;" vertex="1" parent="1"><mxGeometry x="710" y="690" width="290" height="155" as="geometry" /></mxCell>

        <mxCell id="d-ticket" value="&lt;b&gt;ticket&lt;/b&gt;&lt;br&gt;id: string • user_id&lt;br&gt;title, description&lt;br&gt;status&lt;br&gt;upload_url" style="shape=table;childLayout=tableLayout;rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE7F3;strokeColor=#DB2777;spacing=8;" vertex="1" parent="1"><mxGeometry x="1270" y="340" width="245" height="145" as="geometry" /></mxCell>
        <mxCell id="d-chat" value="&lt;b&gt;ticket_chat&lt;/b&gt;&lt;br&gt;id • ticket_id FK • user_id&lt;br&gt;user_role: USER | ADMIN&lt;br&gt;chat • created_at" style="shape=table;childLayout=tableLayout;rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE7F3;strokeColor=#DB2777;spacing=8;" vertex="1" parent="1"><mxGeometry x="1640" y="340" width="260" height="135" as="geometry" /></mxCell>
        <mxCell id="d-storage" value="&lt;b&gt;Storage: tenant-manager&lt;/b&gt;&lt;br&gt;Tenant paths: user / tenant / documents&lt;br&gt;Support paths: user / Support / ticket&lt;br&gt;Public URLs persisted in rows&lt;br&gt;Signed URLs generated for protected reads" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#D1FAE5;strokeColor=#059669;spacing=8;" vertex="1" parent="1"><mxGeometry x="1450" y="650" width="330" height="185" as="geometry" /></mxCell>

        <mxCell id="d-scope" value="&lt;b&gt;Security / tenancy rule&lt;/b&gt;&lt;br&gt;Service methods obtain the current Supabase user and add user_id filters to application-owned records. Database RLS policies should enforce the same boundary server-side." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;spacing=10;" vertex="1" parent="1"><mxGeometry x="1120" y="110" width="790" height="105" as="geometry" /></mxCell>

        <mxCell id="d-flows" value="KEY RUNTIME FLOWS" style="swimlane;html=1;startSize=32;rounded=1;fillColor=#F8FAFC;strokeColor=#64748B;fontStyle=1;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="70" y="950" width="1830" height="315" as="geometry" /></mxCell>
        <mxCell id="d-flow-register" value="&lt;b&gt;1. Registration&lt;/b&gt;&lt;br&gt;RegisterScreen → IdentityService → Edge Function&lt;br&gt;→ create auth user → insert User profile → client login" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE7F3;strokeColor=#DB2777;spacing=10;" vertex="1" parent="1"><mxGeometry x="110" y="1020" width="390" height="115" as="geometry" /></mxCell>
        <mxCell id="d-flow-cache" value="&lt;b&gt;2. Cached domain read&lt;/b&gt;&lt;br&gt;Screen → service → valid in-memory/AsyncStorage cache returned immediately&lt;br&gt;→ background Supabase refresh → cache persisted under authenticated user scope" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;spacing=10;" vertex="1" parent="1"><mxGeometry x="550" y="1020" width="440" height="115" as="geometry" /></mxCell>
        <mxCell id="d-flow-bill" value="&lt;b&gt;3. Billing&lt;/b&gt;&lt;br&gt;Payment form combines active tenant + room + setting rates + latest meter reading&lt;br&gt;→ BillService writes bill → MeterReadingService writes/updates reading → caches invalidated" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;spacing=10;" vertex="1" parent="1"><mxGeometry x="1040" y="1020" width="420" height="115" as="geometry" /></mxCell>
        <mxCell id="d-flow-file" value="&lt;b&gt;4. Files&lt;/b&gt;&lt;br&gt;System picker → content/file URI → BlobUtil ArrayBuffer → Storage upload&lt;br&gt;→ URL in tenant/ticket row; downloads use signed URL + MediaStore/share" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;spacing=10;" vertex="1" parent="1"><mxGeometry x="1510" y="1020" width="350" height="115" as="geometry" /></mxCell>

        <mxCell id="de1" value="1 : 1 logical" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#059669;" edge="1" parent="1" source="d-auth" target="d-user"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="de2" value="user_id scope" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#8B5CF6;dashed=1;" edge="1" parent="1" source="d-user" target="d-setting"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="de3" value="1 : many" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#2563EB;" edge="1" parent="1" source="d-tenant" target="d-map"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="de4" value="many : 1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#2563EB;" edge="1" parent="1" source="d-map" target="d-room"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="de5" value="tenant_id" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#D97706;" edge="1" parent="1" source="d-tenant" target="d-bill"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="de6" value="room_id" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#D97706;" edge="1" parent="1" source="d-room" target="d-bill"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="de7" value="tenant_id" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#F97316;" edge="1" parent="1" source="d-tenant" target="d-meter"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="de8" value="room_id" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#F97316;" edge="1" parent="1" source="d-room" target="d-meter"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="de9" value="1 : many" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#DB2777;" edge="1" parent="1" source="d-ticket" target="d-chat"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="de10" value="document URLs" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;startArrow=block;strokeColor=#059669;dashed=1;" edge="1" parent="1" source="d-tenant" target="d-storage"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="de11" value="attachment URL" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;startArrow=block;strokeColor=#059669;dashed=1;" edge="1" parent="1" source="d-ticket" target="d-storage"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
