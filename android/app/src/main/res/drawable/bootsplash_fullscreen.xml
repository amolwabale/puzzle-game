<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- background color layer -->
  <item>
    <shape>
      <solid android:color="@color/bootsplash_background" />
    </shape>
  </item>

  <!-- scale the bitmap to fill both width and height -->
  <!-- center the bootsplash logo without scaling (use the drawable-nodpi image) -->
  <item>
    <bitmap
      android:src="@drawable/bootsplash_logo"
      android:gravity="center"
      android:tileMode="disabled" />
  </item>
</layer-list>
